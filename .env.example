# Flask Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key for session signing & CSRF protection (replace with a random string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database URI (defaults to SQLite in instance/campus_lost_found.db)
DATABASE_URL=sqlite:///campus_lost_found.db

# Supabase Storage (required in production; create a public bucket named item-images)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=item-images

# Max Upload Size in Megabytes (defaults to 5MB)
MAX_CONTENT_LENGTH=5242880
